---
import { site, contactRows } from "../data/site";

/**
 * The business card — fixed to the bottom corner of every page (HANDOFF §7.6).
 *
 * Rest: a closed card (≥44px). Click: spins, scales up, travels to centre,
 * revealing the contact list. Phone: a compact tab that opens full-screen —
 * no travel, there is no centre worth travelling to at 375px.
 *
 * No-JS: the closed card is a plain link to /contact. Contact information
 * never exists only behind an animation.
 *
 * Reduced motion: the dialog simply appears open (the global reduced-motion
 * rule zeroes the animation).
 */
---

<div class="biz" data-biz>
  <a class="biz__closed" href="/contact" data-biz-open>
    <span class="biz__name">{site.name}</span>
    <span class="biz__hint" aria-hidden="true">say hi ↗</span>
  </a>

  <dialog class="biz__dialog" data-biz-dialog aria-label="Contact card">
    <article class="biz__card">
      <header class="biz__head">
        <h2 class="biz__title">{site.name}</h2>
        <p class="biz__role">{site.role}</p>
        <p class="biz__loc label">{site.location}</p>
      </header>

      <ul class="biz__rows">
        {
          contactRows.map((row) => (
            <li class="biz__row">
              <span class="label">{row.label}</span>
              <a href={row.href} rel={row.me ? "me" : undefined}>
                {row.text}
              </a>
            </li>
          ))
        }
      </ul>

      <button type="button" class="biz__close" data-biz-close>Close</button>
    </article>
  </dialog>
</div>

<style>
  .biz {
    position: fixed;
    right: max(0.9rem, env(safe-area-inset-right));
    bottom: max(0.9rem, env(safe-area-inset-bottom));
    z-index: 60;
  }

  /* ---- rest state: a closed card ---- */

  .biz__closed {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 0.4rem;
    min-height: var(--tap-min);
    min-width: var(--tap-min);
    width: 10.5rem;
    aspect-ratio: 7 / 4;
    padding: 0.6rem 0.7rem;
    background: var(--plate);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    box-shadow: 2px 3px 0 var(--shadow);
    rotate: -2deg;
    text-decoration: none;
    transition: rotate 0.15s ease, translate 0.15s ease;
  }

  .biz__closed:hover {
    rotate: 0deg;
    translate: 0 -2px;
  }

  .biz__name {
    font-size: var(--fs-sm);
    color: var(--ink);
  }

  .biz__hint {
    font-size: var(--fs-xs);
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    color: var(--accent);
  }

  /* Phone: the full card would cover content — compact tab instead. */
  @media (max-width: 40rem) {
    .biz__closed {
      width: auto;
      aspect-ratio: auto;
      flex-direction: row;
      align-items: center;
      rotate: 0deg;
    }

    .biz__name {
      display: none;
    }
  }

  /* ---- open state ---- */

  .biz__dialog {
    border: none;
    padding: 0;
    background: transparent;
    max-width: min(92vw, 26rem);
    /* Travel: from the bottom-right corner to the centre, spinning up. */
    animation: biz-arrive 0.45s cubic-bezier(0.22, 1, 0.36, 1);
  }

  .biz__dialog::backdrop {
    background: rgb(0 0 0 / 0.45);
  }

  @keyframes biz-arrive {
    from {
      transform: translate(38vw, 38vh) rotate(-540deg) scale(0.18);
      opacity: 0.4;
    }
    to {
      transform: none;
      opacity: 1;
    }
  }

  .biz__card {
    background: var(--plate);
    color: var(--ink);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    box-shadow: 4px 6px 0 var(--shadow);
    padding: var(--space-m);
  }

  .biz__head {
    margin-bottom: var(--space-m);
    padding-bottom: var(--space-s);
    border-bottom: 1px solid var(--line);
  }

  .biz__title {
    font-size: var(--fs-md);
  }

  .biz__role {
    margin: 0.3rem 0 0.5rem;
    font-size: var(--fs-sm);
    color: var(--muted);
    max-width: none;
  }

  .biz__rows {
    display: grid;
    gap: 2px;
  }

  .biz__row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-s);
    min-height: var(--tap-min);
    border-bottom: 1px solid var(--line);
  }

  .biz__row:last-child {
    border-bottom: none;
  }

  .biz__row a {
    font-size: var(--fs-sm);
    overflow-wrap: anywhere;
    text-align: right;
  }

  .biz__close {
    margin-top: var(--space-m);
    min-height: var(--tap-min);
    width: 100%;
    font: inherit;
    font-size: var(--fs-xs);
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    background: transparent;
    color: var(--ink);
    border: 1px solid var(--ink);
    border-radius: var(--radius);
    cursor: pointer;
  }

  .biz__close:hover {
    background: var(--ink);
    color: var(--bg);
  }

  /* Phone: full-screen, no travel. */
  @media (max-width: 40rem) {
    .biz__dialog {
      max-width: 100vw;
      width: 100vw;
      height: 100dvh;
      max-height: 100dvh;
      margin: 0;
      animation: biz-fade 0.2s ease;
    }

    .biz__card {
      height: 100%;
      border: none;
      border-radius: 0;
      box-shadow: none;
      overflow-y: auto;
      padding-top: max(var(--space-l), env(safe-area-inset-top));
      padding-bottom: max(var(--space-l), env(safe-area-inset-bottom));
    }

    @keyframes biz-fade {
      from {
        opacity: 0;
      }
      to {
        opacity: 1;
      }
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .biz__dialog {
      animation: none;
    }
  }
</style>

<script>
  const root = document.querySelector<HTMLElement>("[data-biz]");
  const opener = root?.querySelector<HTMLAnchorElement>("[data-biz-open]");
  const dialog = root?.querySelector<HTMLDialogElement>("[data-biz-dialog]");
  const closer = root?.querySelector<HTMLButtonElement>("[data-biz-close]");

  if (opener && dialog) {
    // With JS, the corner link becomes the card's opener. Without it, the
    // href to /contact stands.
    opener.addEventListener("click", (event) => {
      event.preventDefault();
      dialog.showModal();
    });

    closer?.addEventListener("click", () => dialog.close());

    // Click on the backdrop closes — the card itself swallows its clicks.
    dialog.addEventListener("click", (event) => {
      if (event.target === dialog) dialog.close();
    });
  }
</script>
