---
import { Image } from "astro:assets";
import type { CollectionEntry } from "astro:content";

interface Props {
  book: CollectionEntry<"books">;
  /** `current` gets the featured treatment; `past` the compact grid entry. */
  variant: "current" | "past";
}

const { book, variant } = Astro.props;
const { title, author, progress, oneLiner, whyReading, cover, finished } =
  book.data;

const rounded = Math.round(progress);
---

<article
  class:list={["book", `book--${variant}`, cover && "book--with-cover"]}
>
  {
    cover && (
      <div class="book__cover">
        <Image
          src={cover}
          alt={`Cover of ${title}`}
          widths={variant === "current" ? [220, 440] : [120, 240]}
          sizes={variant === "current" ? "220px" : "120px"}
          loading="lazy"
          decoding="async"
        />
      </div>
    )
  }

  <div class="book__body">
    <h3 class="book__title">{title}</h3>
    <p class="label book__author">{author}</p>

    <p class="book__one-liner">{oneLiner}</p>

    {
      variant === "current" && (
        <div class="book__progress">
          <div
            class="book__track"
            role="progressbar"
            aria-valuenow={rounded}
            aria-valuemin="0"
            aria-valuemax="100"
            aria-label={`Progress through ${title}`}
          >
            <div class="book__fill" style={`--progress:${rounded}%`} />
          </div>
          <p class="label book__percent">{rounded}% through</p>
        </div>
      )
    }

    {
      whyReading && (
        <blockquote class="book__why">
          <p class="label book__why-label">Why now</p>
          <p>{whyReading}</p>
        </blockquote>
      )
    }

    {variant === "past" && finished && <p class="label">{finished}</p>}
  </div>
</article>

<style>
  .book {
    display: grid;
    gap: var(--space-s);
  }

  .book__cover {
    border: 1px solid var(--rule);
    border-radius: var(--radius);
    overflow: hidden;
    background: var(--surface);
    align-self: start;
  }

  .book__cover :global(img) {
    width: 100%;
    aspect-ratio: 2 / 3;
    object-fit: cover;
  }

  .book__title {
    margin-bottom: 0.15rem;
  }

  .book__author {
    margin-bottom: var(--space-xs);
  }

  .book__one-liner {
    color: var(--muted);
  }

  /* ---- current ---- */

  .book--current {
    border: var(--border);
    border-radius: var(--radius);
    background: var(--surface-raised);
    padding: var(--space-m);
  }

  .book__progress {
    margin-block: var(--space-s);
  }

  .book__track {
    height: 6px;
    background: color-mix(in srgb, var(--fg) 12%, transparent);
    border-radius: 999px;
    overflow: hidden;
  }

  .book__fill {
    width: var(--progress);
    height: 100%;
    background: var(--accent);
    border-radius: inherit;
  }

  .book__percent {
    margin-top: var(--space-2xs);
  }

  .book__why {
    margin: 0;
    padding-left: var(--space-s);
    border-left: 2px solid var(--accent);
  }

  .book__why-label {
    margin-bottom: 0.15rem;
  }

  .book__why p:last-child {
    color: var(--fg);
    font-style: italic;
    font-family: var(--font-display);
    font-size: var(--step-1);
    line-height: 1.4;
  }

  /* ---- past ---- */

  .book--past {
    border-top: var(--border);
    padding-top: var(--space-s);
  }

  .book--past .book__title {
    font-size: var(--step-0);
    font-weight: 700;
  }

  .book--past .book__one-liner {
    font-size: var(--step--1);
  }

  @media (min-width: 40rem) {
    /* The cover column only exists when there is a cover — otherwise the body
       gets squeezed into a 220px track with nothing beside it. */
    .book--current.book--with-cover {
      grid-template-columns: 220px minmax(0, 1fr);
      gap: var(--space-m);
      align-items: start;
    }
  }
</style>
