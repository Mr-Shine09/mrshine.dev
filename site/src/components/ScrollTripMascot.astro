<div class="scroll-trip-layer" aria-hidden="true">
  <div class="scroll-trip" data-scroll-trip></div>
</div>

<style>
  .scroll-trip-layer {
    position: fixed;
    inset: 0;
    z-index: 40;
    overflow: hidden;
    pointer-events: none;
    contain: strict;
  }

  .scroll-trip {
    --trip-frame: 0;
    --trip-frame-width: 192px;
    --trip-frame-height: 160px;
    --trip-atlas-width: 2304px;

    position: absolute;
    left: 0;
    bottom: max(0.65rem, env(safe-area-inset-bottom));
    width: var(--trip-frame-width);
    height: var(--trip-frame-height);
    background-image: url("/assets/animation/scenes/run-trip-recover-atlas.png");
    background-size: var(--trip-atlas-width) var(--trip-frame-height);
    background-position: calc(var(--trip-frame) * var(--trip-frame-width) * -1) 0;
    background-repeat: no-repeat;
    image-rendering: pixelated;
    will-change: transform, background-position;
    transform: translate3d(110vw, 0, 0);
  }

  .scroll-trip[data-mode="walking"] {
    background-image: url("/assets/animation/scenes/walking-atlas.png");
  }

  /* A fixed mascot on a phone covers content and controls — omit it there
     (HANDOFF §11.2 prefers no traveller to an overlaying one). */
  @media (max-width: 40rem), (prefers-reduced-motion: reduce) {
    .scroll-trip-layer {
      display: none;
    }
  }
</style>

<script>
  const FRAME_COUNT = 12;
  const STORY_LOOPS = 4;
  /* Pages shorter than this many viewports get the calm walking cycle; long
     pages earn the intricate run-trip-recover beat (HANDOFF §11.1). Pages
     with almost no scroll get no traveller at all. */
  const MIN_RANGE_RATIO = 0.35;
  const LONG_PAGE_RATIO = 2.5;

  function mountScrollTrip(el: HTMLElement) {
    if (el.dataset.ready === "true") return;
    el.dataset.ready = "true";

    let targetProgress = 0;
    let renderedProgress = 0;
    let animationFrame = 0;
    let lastX = Infinity;

    const rangeRatio = () => {
      const root = document.documentElement;
      return (root.scrollHeight - window.innerHeight) / Math.max(1, window.innerHeight);
    };

    const applyMode = () => {
      const ratio = rangeRatio();
      el.style.display = ratio < MIN_RANGE_RATIO ? "none" : "";
      el.dataset.mode = ratio >= LONG_PAGE_RATIO ? "story" : "walking";
    };

    const readProgress = () => {
      const root = document.documentElement;
      const scrollRange = Math.max(1, root.scrollHeight - window.innerHeight);
      targetProgress = Math.min(1, Math.max(0, window.scrollY / scrollRange));
      if (!animationFrame) animationFrame = requestAnimationFrame(render);
    };

    const render = () => {
      animationFrame = 0;
      renderedProgress += (targetProgress - renderedProgress) * 0.14;

      const width = el.getBoundingClientRect().width;
      const travel = window.innerWidth + width * 2.4;
      const x = window.innerWidth + width * 0.7 - renderedProgress * travel;

      let frame: number;
      let flip = 1;
      if (el.dataset.mode === "walking") {
        // Scrub the gait from distance travelled so the feet stay planted.
        // The cycle is authored walking rightward — flip for leftward travel.
        const stride = Math.max(12, width / 8);
        frame = Math.floor(Math.abs(x) / stride) % FRAME_COUNT;
        flip = x < lastX ? -1 : 1;
      } else {
        const storyStep = Math.floor(renderedProgress * STORY_LOOPS * FRAME_COUNT);
        frame = Math.min(FRAME_COUNT - 1, Math.max(0, storyStep % FRAME_COUNT));
      }
      lastX = x;

      el.style.transform = `translate3d(${x.toFixed(2)}px, 0, 0) scaleX(${flip})`;
      el.style.setProperty("--trip-frame", String(frame));

      if (Math.abs(targetProgress - renderedProgress) > 0.0002) {
        animationFrame = requestAnimationFrame(render);
      }
    };

    window.addEventListener("scroll", readProgress, { passive: true });
    window.addEventListener("resize", () => {
      applyMode();
      readProgress();
    });
    applyMode();
    readProgress();
  }

  for (const el of document.querySelectorAll<HTMLElement>("[data-scroll-trip]")) {
    mountScrollTrip(el);
  }
</script>
