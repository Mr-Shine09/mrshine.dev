<div class="scroll-trip-layer" aria-hidden="true">
  <div class="scroll-trip" data-scroll-trip></div>
</div>

<style>
  .scroll-trip-layer {
    position: fixed;
    inset: 0;
    z-index: 40;
    overflow: hidden;
    pointer-events: none;
    contain: strict;
  }

  .scroll-trip {
    --trip-frame: 0;
    --trip-frame-width: 192px;
    --trip-frame-height: 160px;
    --trip-atlas-width: 2304px;

    position: absolute;
    left: 0;
    bottom: max(0.65rem, env(safe-area-inset-bottom));
    width: var(--trip-frame-width);
    height: var(--trip-frame-height);
    background-image: url("/assets/animation/scenes/run-trip-recover-atlas.png");
    background-size: var(--trip-atlas-width) var(--trip-frame-height);
    background-position: calc(var(--trip-frame) * var(--trip-frame-width) * -1) 0;
    background-repeat: no-repeat;
    image-rendering: pixelated;
    will-change: transform, background-position;
    transform: translate3d(110vw, 0, 0);
  }

  @media (max-width: 40rem) {
    .scroll-trip {
      --trip-frame-width: 144px;
      --trip-frame-height: 120px;
      --trip-atlas-width: 1728px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .scroll-trip-layer {
      display: none;
    }
  }
</style>

<script>
  const FRAME_COUNT = 12;
  const STORY_LOOPS = 4;

  function mountScrollTrip(el: HTMLElement) {
    if (el.dataset.ready === "true") return;
    el.dataset.ready = "true";

    let targetProgress = 0;
    let renderedProgress = 0;
    let animationFrame = 0;

    const readProgress = () => {
      const root = document.documentElement;
      const scrollRange = Math.max(1, root.scrollHeight - window.innerHeight);
      targetProgress = Math.min(1, Math.max(0, window.scrollY / scrollRange));
      if (!animationFrame) animationFrame = requestAnimationFrame(render);
    };

    const render = () => {
      animationFrame = 0;
      renderedProgress += (targetProgress - renderedProgress) * 0.14;

      const width = el.getBoundingClientRect().width;
      const travel = window.innerWidth + width * 2.4;
      const x = window.innerWidth + width * 0.7 - renderedProgress * travel;
      const storyStep = Math.floor(renderedProgress * STORY_LOOPS * FRAME_COUNT);
      const frame = Math.min(FRAME_COUNT - 1, Math.max(0, storyStep % FRAME_COUNT));

      el.style.transform = `translate3d(${x.toFixed(2)}px, 0, 0)`;
      el.style.setProperty("--trip-frame", String(frame));

      if (Math.abs(targetProgress - renderedProgress) > 0.0002) {
        animationFrame = requestAnimationFrame(render);
      }
    };

    window.addEventListener("scroll", readProgress, { passive: true });
    window.addEventListener("resize", readProgress);
    readProgress();
  }

  for (const el of document.querySelectorAll<HTMLElement>("[data-scroll-trip]")) {
    mountScrollTrip(el);
  }
</script>
