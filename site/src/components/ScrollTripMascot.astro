<div class="scroll-trip-layer" aria-hidden="true">
  <div class="scroll-trip" data-scroll-trip>
    <img
      class="scroll-trip__sprite"
      data-scroll-trip-sprite
      src="/assets/animation/scenes/walking-static.png"
      alt=""
      width="384"
      height="320"
    />
  </div>
</div>

<style>
  .scroll-trip-layer {
    position: fixed;
    inset: 0;
    z-index: 40;
    overflow: hidden;
    pointer-events: none;
    contain: strict;
  }

  .scroll-trip {
    position: absolute;
    left: 0;
    bottom: max(0.65rem, env(safe-area-inset-bottom));
    width: 192px;
    height: 160px;
    will-change: transform;
    transform: translate3d(110vw, 0, 0);
  }

  .scroll-trip__sprite {
    display: block;
    width: 192px;
    height: 160px;
    object-fit: contain;
    image-rendering: pixelated;
  }

  @media (max-width: 40rem), (prefers-reduced-motion: reduce) {
    .scroll-trip-layer {
      display: none;
    }
  }
</style>

<script>
  const MIN_RANGE_RATIO = 0.35;
  /* The current About gallery is ~2.1 viewports of scrollable range. */
  const LONG_PAGE_RATIO = 1.75;
  let travellerToken = 0;

  function mountScrollTrip(el: HTMLElement) {
    if (el.dataset.ready === "true") return;
    el.dataset.ready = "true";

    const sprite = el.querySelector<HTMLImageElement>("[data-scroll-trip-sprite]");
    if (!sprite) return;

    let targetProgress = 0;
    let renderedProgress = 0;
    let animationFrame = 0;
    let lastX = Infinity;

    const rangeRatio = () => {
      const root = document.documentElement;
      return (root.scrollHeight - window.innerHeight) / Math.max(1, window.innerHeight);
    };

    const applyMode = () => {
      const ratio = rangeRatio();
      el.style.display = ratio < MIN_RANGE_RATIO ? "none" : "";
      const mode = ratio >= LONG_PAGE_RATIO ? "run" : "walking";
      if (el.dataset.mode === mode) return;
      el.dataset.mode = mode;
      sprite.src = `/assets/animation/scenes/${mode}-atlas.png?play=${++travellerToken}`;
    };

    const readProgress = () => {
      const root = document.documentElement;
      const scrollRange = Math.max(1, root.scrollHeight - window.innerHeight);
      targetProgress = Math.min(1, Math.max(0, window.scrollY / scrollRange));
      if (!animationFrame) animationFrame = requestAnimationFrame(render);
    };

    const render = () => {
      animationFrame = 0;
      renderedProgress += (targetProgress - renderedProgress) * 0.14;

      const width = el.getBoundingClientRect().width;
      const travel = window.innerWidth + width * 2.4;
      const x = window.innerWidth + width * 0.7 - renderedProgress * travel;
      const flip = x < lastX ? -1 : 1;
      lastX = x;

      el.style.transform = `translate3d(${x.toFixed(2)}px, 0, 0) scaleX(${flip})`;

      if (Math.abs(targetProgress - renderedProgress) > 0.0002) {
        animationFrame = requestAnimationFrame(render);
      }
    };

    window.addEventListener("scroll", readProgress, { passive: true });
    window.addEventListener("resize", () => {
      applyMode();
      readProgress();
    });
    applyMode();
    readProgress();
  }

  for (const el of document.querySelectorAll<HTMLElement>("[data-scroll-trip]")) {
    mountScrollTrip(el);
  }
</script>
