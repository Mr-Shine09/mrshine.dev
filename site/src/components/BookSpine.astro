---
import type { CollectionEntry } from "astro:content";

interface Props {
  book: CollectionEntry<"books">;
  /** Position on its shelf — drives palette assignment and the lean. */
  index: number;
}

/**
 * One rendered spine (HANDOFF §7.3). Colours come from the mascot's frozen
 * 12-colour palette (--px-*), assigned by shelf position so no two adjacent
 * spines match; each background names its own text colour — some need light,
 * some dark. Width derives from page count where known.
 *
 * The spine is a link to the book's detail panel below the shelves — works
 * with no JS at all. The rotated title is aria-hidden; the accessible name
 * reads normally.
 */

const { book, index } = Astro.props;
const { title, author, status, pageCount, spineColor } = book.data;

const STATUS_LABEL = {
  reading: "currently reading",
  finished: "finished",
  want: "want to read",
} as const;

/* Palette pairs verified for text contrast against each spine colour. */
const PALETTE = [
  { bg: "var(--px-navy-1)", fg: "var(--px-paper)" },
  { bg: "var(--px-amber-1)", fg: "var(--px-ink)" },
  { bg: "var(--px-rust)", fg: "var(--px-paper)" },
  { bg: "var(--px-navy-3)", fg: "var(--px-paper)" },
  { bg: "var(--px-amber-2)", fg: "var(--px-ink)" },
  { bg: "var(--px-grey-3)", fg: "var(--px-paper)" },
];

const paint = spineColor
  ? { bg: spineColor, fg: "var(--px-paper)" }
  : PALETTE[index % PALETTE.length];

/* Width from page count where known; height varies a little per book so the
   shelf reads as a shelf, not a bar chart. */
const width = pageCount ? Math.round(Math.min(72, Math.max(44, 30 + pageCount / 12))) : 48;
const height = 168 + ((index * 37) % 48);

/* A couple of leaning spines make it a real shelf — never enough lean to
   overlap a neighbour's tap target. */
const lean = index % 3 === 2 ? -3.5 : 0;
---

<li class="spine-slot" data-book-item data-search={`${title} ${author}`}>
  <a
    class="spine"
    href={`#book-${book.id}`}
    aria-label={`${title} by ${author}, ${STATUS_LABEL[status]}`}
    style={`--spine-bg:${paint.bg};--spine-fg:${paint.fg};--spine-w:${width}px;--spine-h:${height}px;--spine-lean:${lean}deg;`}
  >
    <span class="spine__title" aria-hidden="true">{title}</span>
    {status === "reading" && <span class="spine__mark" aria-hidden="true"></span>}
  </a>
</li>

<style>
  .spine-slot {
    display: flex;
    align-items: flex-end;
    flex: none;
  }

  .spine {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    /* The visible spine may be narrower than 44px — the tap target never is. */
    min-width: var(--tap-min);
    width: max(var(--spine-w), var(--tap-min));
    height: var(--spine-h);
    text-decoration: none;
    rotate: var(--spine-lean);
    transform-origin: bottom center;
    transition: translate 0.15s ease;
  }

  .spine::before {
    content: "";
    position: absolute;
    inset: 0 calc((100% - var(--spine-w)) / 2);
    background: var(--spine-bg);
    border-radius: 2px 2px 0 0;
    box-shadow: inset -3px 0 0 rgb(0 0 0 / 0.18), inset 0 4px 0 rgb(255 255 255 / 0.12);
  }

  .spine:hover {
    translate: 0 -6px;
  }

  .spine__title {
    position: relative;
    writing-mode: vertical-rl;
    font-size: var(--fs-sm);
    color: var(--spine-fg);
    max-height: calc(var(--spine-h) - 2.4rem);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  /* Status marker: a band near the foot, not a text label. */
  .spine__mark {
    position: absolute;
    bottom: 12px;
    left: calc((100% - var(--spine-w)) / 2 + 6px);
    right: calc((100% - var(--spine-w)) / 2 + 6px);
    height: 4px;
    background: var(--spine-fg);
    opacity: 0.85;
  }

  @media (prefers-reduced-motion: reduce) {
    .spine:hover {
      translate: none;
    }
  }
</style>
