---
import Mascot from "./Mascot.astro";
import { site } from "../data/site";

const { github } = site.socials;
---

<section class="hero section" id="about">
  <div class="wrap hero__grid">
    <div class="hero__text">
      <p class="label">{site.location}</p>

      <h1 class="hero__name">{site.name}</h1>

      <p class="hero__role">{site.role}</p>

      <p class="hero__tagline lede">{site.tagline}</p>

      <div class="hero__actions">
        {
          github && (
            <a class="btn btn--primary" href={github} rel="me noopener">
              GitHub
            </a>
          )
        }
        {
          /* The button removes itself until a real PDF exists — an empty
             résumé link is worse than no résumé link. */
          site.resumeUrl && (
            <a class="btn" href={site.resumeUrl}>
              Résumé
            </a>
          )
        }
        <a class="btn" href="#contact">Get in touch</a>
      </div>
    </div>

    <div class="hero__mascot">
      {/*
        The `waiting` row is a one-shot hand-raise on the desktop app. Ponging
        it 0→1→2→3→2→1 at a flat 190ms turns the same four frames into a wave,
        which is what a front door wants. Clock overlay stripped in
        scripts/strip-clock-overlay.js.
      */}
      <Mascot
        state="waiting"
        sequence={[0, 1, 2, 3, 2, 1]}
        frameDuration={190}
        scale={3}
        label={`Pixel-art mascot of ${site.name}, waving`}
      />
    </div>
  </div>
</section>

<style>
  .hero {
    /* The front door does not need the full section rhythm above it. */
    padding-block: clamp(var(--space-xl), 9vw, var(--space-2xl));
  }

  .hero__grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: center;
    gap: var(--space-l);
  }

  .hero__name {
    margin-block: var(--space-2xs) var(--space-xs);
  }

  .hero__role {
    font-size: var(--step-1);
    margin-bottom: var(--space-s);
  }

  .hero__tagline {
    max-width: 40ch;
    margin-bottom: var(--space-m);
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-xs);
  }

  .hero__mascot {
    display: flex;
    justify-content: center;
  }

  @media (max-width: 46rem) {
    .hero__grid {
      grid-template-columns: minmax(0, 1fr);
      gap: var(--space-m);
    }

    .hero__mascot {
      order: -1;
      justify-content: flex-start;
    }
  }

  @media (max-width: 30rem) {
    .hero__mascot {
      /* At 3x the sprite alone is taller than the fold and pushes the name
         off screen. Two is still an integer scale, so the pixels stay square. */
      --mascot-scale: 2;
    }
  }
</style>
