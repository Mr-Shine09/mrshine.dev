---
import Mascot from "./Mascot.astro";
import { site } from "../data/site";

const { github, linkedin, email } = site.socials;

// A named list, not icon soup — each row says where it goes and why.
const rows = [
  email && { label: "Email", value: email, href: `mailto:${email}` },
  github && {
    label: "GitHub",
    value: github.replace(/^https?:\/\//, ""),
    href: github,
  },
  linkedin && {
    label: "LinkedIn",
    value: linkedin.replace(/^https?:\/\//, ""),
    href: linkedin,
  },
].filter(Boolean) as { label: string; value: string; href: string }[];

const year = new Date().getFullYear();
---

<footer class="contact section" id="contact">
  <div class="wrap">
    <div class="section-head">
      <h2>Get in touch</h2>
      <p class="lede">
        The inbox is the reliable one. Everything else I check when I remember.
      </p>
    </div>

    <div class="contact__card">
      <div class="contact__main">
        <p class="label">Contact card</p>
        <p class="contact__name">{site.name}</p>
        <p class="contact__role">{site.role} · {site.location}</p>

        <dl class="contact__rows">
          {
            rows.map((row) => (
              <div class="contact__row">
                <dt class="label">{row.label}</dt>
                <dd>
                  <a href={row.href} rel="noopener">
                    {row.value}
                  </a>
                </dd>
              </div>
            ))
          }
        </dl>

        <div class="contact__actions">
          <a class="btn" href="/contact.vcf" download>Download vCard</a>
          <button class="btn" type="button" data-copy-link>
            <span data-copy-label>Copy link to this page</span>
          </button>
        </div>
      </div>

      <div class="contact__mascot">
        {/* The page goes to sleep here — locked sprite mapping. */}
        <Mascot state="sleeping" scale={2} />
      </div>
    </div>

    <p class="contact__colophon">
      <span>© {year} {site.name}.</span>
      <span>
        Built with Astro. Coloured entirely from the mascot's own twelve-colour
        palette.
      </span>
    </p>
  </div>
</footer>

<style>
  .contact__card {
    display: grid;
    gap: var(--space-m);
    align-items: end;
    border: var(--border);
    border-radius: var(--radius);
    background: var(--surface-raised);
    padding: var(--space-m);
  }

  .contact__name {
    font-family: var(--font-display);
    font-size: var(--step-2);
    font-weight: 700;
    line-height: 1.1;
    margin-block: var(--space-2xs) 0.15rem;
  }

  .contact__role {
    color: var(--muted);
    margin-bottom: var(--space-m);
  }

  .contact__rows {
    margin: 0 0 var(--space-m);
    display: grid;
    gap: var(--space-2xs);
  }

  .contact__row {
    display: grid;
    grid-template-columns: 7rem minmax(0, 1fr);
    gap: var(--space-xs);
    align-items: baseline;
    padding-block: 0.35rem;
    border-top: var(--border);
  }

  .contact__row dd {
    margin: 0;
    overflow-wrap: anywhere;
  }

  .contact__row dd a {
    /* Inline links still need a thumb-sized target. */
    display: inline-flex;
    align-items: center;
    min-height: 44px;
  }

  .contact__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-xs);
  }

  .contact__mascot {
    display: flex;
    justify-content: flex-end;
  }

  .contact__colophon {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-xs) var(--space-m);
    margin-top: var(--space-l);
    padding-top: var(--space-s);
    border-top: var(--border);
    font-size: var(--step--1);
    color: var(--muted);
    max-width: none;
  }

  @media (min-width: 46rem) {
    .contact__card {
      grid-template-columns: minmax(0, 1fr) auto;
      padding: var(--space-l);
    }
  }

  @media (max-width: 30rem) {
    .contact__row {
      grid-template-columns: minmax(0, 1fr);
      gap: 0;
    }
  }
</style>

<script>
  const button = document.querySelector<HTMLButtonElement>("[data-copy-link]");
  const label = document.querySelector<HTMLElement>("[data-copy-label]");

  if (button && label) {
    const idle = label.textContent ?? "Copy link to this page";
    let revert: ReturnType<typeof setTimeout>;

    const flash = (message: string) => {
      label.textContent = message;
      clearTimeout(revert);
      revert = setTimeout(() => {
        label.textContent = idle;
      }, 2000);
    };

    button.addEventListener("click", async () => {
      const url = window.location.href.split("#")[0];
      try {
        await navigator.clipboard.writeText(url);
        flash("Copied");
      } catch {
        // Clipboard blocked (insecure context, or permission denied).
        flash("Press ⌘C to copy");
        const selection = window.getSelection();
        const range = document.createRange();
        range.selectNodeContents(label);
        selection?.removeAllRanges();
        selection?.addRange(range);
      }
    });
  }
</script>
