---
import { getCollection } from "astro:content";
import AnimatedScene from "./AnimatedScene.astro";
import SectionHead from "./SectionHead.astro";
import Icon from "./Icon.astro";

const COMING_SOON_BELOW = 3;
const all = (await getCollection("achievements")).sort((a, b) => a.data.order - b.data.order);
const awards = all.filter((e) => e.data.kind !== "hackathon");
const hackathons = all.filter((e) => e.data.kind === "hackathon");

const columns = [
  { title: "Awards & contests", icon: "tabler/trophy", items: awards, soon: awards.length < COMING_SOON_BELOW },
  { title: "Hackathons", icon: "tabler/code", items: hackathons, soon: false },
];
---
<section id="highlights" class="section" aria-labelledby="highlights-title">
  <div class="wrap">
    <SectionHead id="highlights" title="Highlights" emoji="🏆" />
    <div class="highlights">
      <div class="highlights__scene"><AnimatedScene scene="trophy-lift" /></div>
      <div class="highlights__columns">
        {columns.map((col, i) => (
          <div class="hl-col" data-reveal style={`--reveal-delay: ${i * 0.1}s`}>
            <h3 class="hl-col__title label">{col.title}</h3>
            <ul class="achievements">
              {col.items.map(({ data }) => (
                <li class="achievement">
                  <span class="achievement__glyph" aria-hidden="true"><Icon name={col.icon} size={20} /></span>
                  <span class="achievement__text">
                    <span class="achievement__title">{data.link ? <a href={data.link} rel="noopener">{data.title}</a> : data.title}</span>
                    <span class="achievement__meta">{[data.org, data.year].filter(Boolean).join(" · ")}</span>
                  </span>
                </li>
              ))}
            </ul>
            {col.soon && <p class="highlights__soon">More achievements coming soon.</p>}
          </div>
        ))}
      </div>
    </div>
  </div>
</section>

<style>
  .highlights { display: grid; grid-template-columns: auto minmax(0, 1fr); gap: var(--space-l); align-items: start; }
  .highlights__scene { align-self: start; }
  .highlights__columns { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: var(--space-l); }
  .hl-col__title { color: var(--accent); display: inline-block; padding-bottom: 0.4rem; border-bottom: 2px solid var(--accent); margin-bottom: var(--space-s); }
  .achievements { display: grid; }
  .achievement { display: flex; gap: var(--space-s); align-items: flex-start; min-height: var(--tap-min); padding: var(--space-s) 0; border-bottom: var(--border); }
  .achievement__glyph { color: var(--accent); display: inline-flex; margin-top: 0.15rem; }
  .achievement__text { display: grid; gap: 0.25rem; }
  .achievement__title { font-weight: 500; }
  .achievement__meta { font-size: var(--fs-xs); letter-spacing: 0.1em; text-transform: uppercase; color: var(--muted); }
  .highlights__soon { margin-top: var(--space-m); color: var(--muted); }
  @media (max-width: 64rem) { .highlights { grid-template-columns: 1fr; } .highlights__scene { justify-self: center; } }
  @media (max-width: 48rem) { .highlights__columns { grid-template-columns: 1fr; } }
</style>
