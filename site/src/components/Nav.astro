---
import ThemeToggle from "./ThemeToggle.astro";
import { site } from "../data/site";

// Mirrors the section order on the page exactly — past, present, future.
const links = [
  { href: "#about", label: "About" },
  { href: "#built", label: "Built" },
  { href: "#current", label: "Current" },
  { href: "#ahead", label: "Ahead" },
  { href: "#contact", label: "Contact" },
];
---

<header class="nav" data-nav>
  <nav class="nav__inner wrap" aria-label="Sections">
    <a class="nav__name" href="#about">{site.name}</a>

    <ul class="nav__links">
      {
        links.map((link) => (
          <li>
            <a href={link.href} data-nav-link>
              {link.label}
            </a>
          </li>
        ))
      }
    </ul>

    <ThemeToggle />
  </nav>
</header>

<style>
  .nav {
    --nav-pad: 0.85rem;
    position: sticky;
    top: 0;
    z-index: 50;
    background: color-mix(in srgb, var(--bg) 88%, transparent);
    backdrop-filter: blur(10px);
    border-bottom: 1px solid transparent;
    transition: border-color 0.2s ease, padding 0.2s ease;
  }

  /* Compact on scroll: the rule appears and the bar tightens. */
  .nav[data-scrolled] {
    --nav-pad: 0.45rem;
    border-bottom-color: var(--rule);
  }

  .nav__inner {
    display: flex;
    align-items: center;
    gap: var(--space-s);
    padding-block: var(--nav-pad);
    transition: padding 0.2s ease;
  }

  .nav__name {
    font-family: var(--font-display);
    font-size: var(--step-0);
    font-weight: 700;
    text-decoration: none;
    white-space: nowrap;
    flex: none;
  }

  .nav__links {
    display: flex;
    align-items: center;
    gap: clamp(0.7rem, 2.5vw, 1.6rem);
    margin-inline: auto;
    /* Anchors stay one scrollable row on narrow screens rather than becoming a
       hamburger — five short words do not justify a menu. */
    overflow-x: auto;
    scrollbar-width: none;
    -webkit-overflow-scrolling: touch;
  }

  .nav__links::-webkit-scrollbar {
    display: none;
  }

  .nav__links a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding-inline: 0.15rem;
    font-size: var(--step--1);
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    color: var(--muted);
    text-decoration: none;
    white-space: nowrap;
    border-bottom: 2px solid transparent;
    transition: color 0.15s ease, border-color 0.15s ease;
  }

  .nav__links a:hover {
    color: var(--fg);
  }

  .nav__links a[aria-current="true"] {
    color: var(--fg);
    border-bottom-color: var(--accent);
  }

  @media (max-width: 34rem) {
    .nav__name {
      /* Reclaim the width for the anchors; the hero says the name anyway. */
      display: none;
    }
    .nav__links {
      margin-inline: 0;
      margin-right: auto;
    }
  }
</style>

<script>
  const nav = document.querySelector<HTMLElement>("[data-nav]");

  // Publish the real bar height so `scroll-padding-top` can clear it exactly.
  const publishHeight = () => {
    if (!nav) return;
    document.documentElement.style.setProperty(
      "--nav-h",
      `${nav.offsetHeight}px`
    );
  };
  publishHeight();
  window.addEventListener("resize", publishHeight);

  // Compact state, driven by a sentinel rather than a scroll listener.
  const sentinel = document.createElement("div");
  sentinel.setAttribute("aria-hidden", "true");
  sentinel.style.cssText = "position:absolute;top:0;height:1px;width:1px;";
  document.body.prepend(sentinel);

  new IntersectionObserver(
    ([entry]) => {
      if (!nav) return;
      nav.toggleAttribute("data-scrolled", !entry.isIntersecting);
      publishHeight();
    },
    { threshold: 0 }
  ).observe(sentinel);

  // Active section highlighting.
  const navLinks = [
    ...document.querySelectorAll<HTMLAnchorElement>("[data-nav-link]"),
  ];
  const byId = new Map(
    navLinks.map((link) => [link.getAttribute("href")?.slice(1) ?? "", link])
  );

  const sections = navLinks
    .map((link) => document.querySelector(link.getAttribute("href") ?? ""))
    .filter((el): el is HTMLElement => el instanceof HTMLElement);

  const visible = new Set<string>();

  const paint = () => {
    // When several sections are on screen, the topmost one wins.
    const active = sections.find((section) => visible.has(section.id))?.id;
    for (const [id, link] of byId) {
      if (id === active) link.setAttribute("aria-current", "true");
      else link.removeAttribute("aria-current");
    }
  };

  const observer = new IntersectionObserver(
    (entries) => {
      for (const entry of entries) {
        if (entry.isIntersecting) visible.add(entry.target.id);
        else visible.delete(entry.target.id);
      }
      paint();
    },
    { rootMargin: "-20% 0px -60% 0px" }
  );

  for (const section of sections) observer.observe(section);
</script>
