---
import Mascot from "./Mascot.astro";
import type { CollectionEntry } from "astro:content";

interface Props {
  hobby: CollectionEntry<"hobbies">;
}

const { hobby } = Astro.props;
const { title, blurb, spriteState } = hobby.data;
---

<article class="hobby">
  <Mascot state={spriteState} scale={1} class="hobby__sprite" />
  <div>
    <h3 class="hobby__title">{title}</h3>
    <p class="hobby__blurb">{blurb}</p>
  </div>
</article>

<style>
  .hobby {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    gap: var(--space-s);
    align-items: center;
    padding: var(--space-s) 0;
    border-top: var(--border);
  }

  .hobby__title {
    font-size: var(--step-0);
    font-weight: 700;
    margin-bottom: 0.15rem;
  }

  .hobby__blurb {
    color: var(--muted);
    font-size: var(--step--1);
    margin: 0;
  }
</style>
