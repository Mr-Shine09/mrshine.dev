---
import { Image } from "astro:assets";
import type { CollectionEntry } from "astro:content";
import Icon from "./Icon.astro";

interface Props { project: CollectionEntry<"projects">; index: number; total: number }
const { project, index, total } = Astro.props;
const { data } = project;
// `builtAt` often already names the year ("… Hackathon 2026"); do not repeat it.
const meta = [data.builtAt?.includes(data.year) ? null : data.year, data.builtAt].filter(Boolean).join(" · ");

// Stack chip → Devicon (brand colours). Unmapped tools render as plain chips.
const devicon: Record<string, string> = {
  Swift: "swift", SwiftUI: "swift", AppKit: "apple", XcodeGen: "xcode",
  "Python 3": "python", "Python 3.11": "python", Python: "python",
  Flutter: "flutter", Dart: "dart", Kotlin: "kotlin", SQLite: "sqlite",
  FastAPI: "fastapi", "Redis Stack": "redis", Vite: "vitejs", Flask: "flask",
  "Raspberry Pi 5": "raspberrypi", YOLOv8n: "pytorch",
};
---
<article class="card" tabindex="0" aria-roledescription="slide" aria-label={`${index + 1} of ${total}: ${data.title}`}>
  <div class="card__plate">
    {data.image && <Image class="card__image" src={data.image} alt={data.imageAlt ?? ""} width={640} densities={[1, 2]} loading="lazy" />}
  </div>
  <div class="card__body">
    <h3 class="card__title">{data.title}</h3>
    <p class="card__summary">{data.summary}</p>
    <ul class="card__stack" aria-label="Stack">
      {data.stack.map((s) => (
        <li class:list={["chip", { "chip--icon": !!devicon[s] }]}>
          {devicon[s] && <Icon name={`devicon/${devicon[s]}`} size={14} />}
          {s}
        </li>
      ))}
    </ul>
    {meta && <p class="card__meta">{meta}</p>}
    {data.collaborators.length > 0 && <p class="card__team">Team: {data.collaborators.join(" · ")}</p>}
    <p class="card__links">
      {data.links.github && (
        <a class="btn btn--outline" href={data.links.github} rel="noopener">
          <Icon name="devicon/github" size={16} mono /><span class="btn__label">GitHub</span><Icon name="tabler/arrow-up-right" size={14} class="btn__arrow" />
        </a>
      )}
      {data.links.devpost && (
        <a class="btn btn--outline" href={data.links.devpost} rel="noopener">
          <span class="btn__label">Devpost</span><Icon name="tabler/arrow-up-right" size={14} class="btn__arrow" />
        </a>
      )}
      {data.links.live && (
        <a class="btn btn--primary" href={data.links.live} rel="noopener">
          <span class="btn__ico"><Icon name="tabler/world" size={16} /></span><span class="btn__label">Live</span>
        </a>
      )}
    </p>
  </div>
</article>

<style>
  .card {
    scroll-snap-align: center; flex: 0 0 min(85vw, 34rem);
    display: grid; grid-template-rows: auto 1fr;
    border: var(--border); border-radius: var(--radius); background: var(--bg);
    transform-origin: center; min-width: 0;
    transition: border-color 0.2s ease, box-shadow 0.2s ease;
  }
  .card:hover, .card:focus-within { border-color: var(--ink); box-shadow: 6px 6px 0 var(--line); }
  .card__plate { position: relative; aspect-ratio: 16 / 10; background: var(--plate); overflow: hidden; border-bottom: var(--border); }
  .card__image { position: absolute; inset: var(--space-s); width: calc(100% - 2 * var(--space-s)); height: calc(100% - 2 * var(--space-s)); object-fit: contain; }
  .card__body { display: grid; gap: var(--space-s); padding: var(--space-m); align-content: start; }
  .card__summary { color: var(--ink); }
  .card__stack { display: flex; flex-wrap: wrap; gap: 0.4rem; }
  .card__team { font-size: var(--fs-sm); color: var(--muted); }
  .card__meta { font-size: var(--fs-xs); color: var(--muted); letter-spacing: 0.1em; text-transform: uppercase; }
  .card__links { display: flex; flex-wrap: wrap; gap: var(--space-xs); }
  /* Receded cards scale to 0.82; keep their buttons ≥44px after scaling. */
  .card__links :global(.btn) { min-height: calc(var(--tap-min) / 0.82 + 1px); }

  /* Coverflow: the centred card is full size; neighbours recede. Scroll-driven,
     no JS; browsers without support get a flat, fully usable snap carousel. */
  @supports (animation-timeline: view()) {
    .card { animation: card-focus linear both; }
    :global(.slider__track) .card { animation-timeline: view(inline); animation-range: cover 0% cover 100%; }
    @keyframes card-focus { 0%, 100% { transform: scale(0.82); opacity: 0.6; } 50% { transform: scale(1); opacity: 1; } }
  }
  @media (prefers-reduced-motion: reduce) { .card { animation: none; } }
</style>
