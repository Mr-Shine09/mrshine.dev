---
import { Image } from "astro:assets";
import type { CollectionEntry } from "astro:content";

interface Props {
  project: CollectionEntry<"projects">;
}

/**
 * One card in the uniform flip deck (HANDOFF §7.2).
 *
 * Front: name · image matted on a --plate field (contain, never crop) ·
 * one-line summary · the repo link (the no-JS fallback lives on the front).
 * Back: stack chips · what was hard (the body) · year · collaborators · links.
 *
 * Flip on click, never hover. No-JS: both faces render stacked, nothing is
 * hidden. With JS the flip button appears and the face-down side goes `inert`,
 * so its links can never trap keyboard focus. Reduced motion: the global rule
 * zeroes the transition — faces swap with no visible rotation.
 */

const { project } = Astro.props;
const { title, year, stack, summary, image, imageAlt, collaborators, builtAt, links, metric } =
  project.data;
---

<article class="pcard" data-pcard>
  <div class="pcard__inner" data-pcard-inner>
    <div class="pcard__face pcard__front" data-pcard-front>
      <div class="pcard__plate">
        {image ? (
          <Image src={image} alt={imageAlt ?? ""} class="pcard__shot" />
        ) : (
          <span class="pcard__plate-empty label">image on its way</span>
        )}
      </div>
      <h3 class="pcard__title">{title}</h3>
      <p class="pcard__summary">{summary}</p>
      <p class="pcard__front-links">
        {links.github && <a href={links.github}>GitHub ↗</a>}
        <button type="button" class="pcard__flip" data-pcard-flip hidden>
          Details <span aria-hidden="true">⟳</span>
        </button>
      </p>
    </div>

    <div class="pcard__face pcard__back" data-pcard-back>
      <h3 class="pcard__title">{title}</h3>
      {stack.length > 0 && (
        <ul class="pcard__chips" aria-label="Stack">
          {stack.map((item) => (
            <li class="pcard__chip">{item}</li>
          ))}
        </ul>
      )}
      <div class="pcard__body">
        <slot />
      </div>
      <dl class="pcard__meta">
        <div class="pcard__meta-row">
          <dt class="label">Year</dt>
          <dd>{year}</dd>
        </div>
        {builtAt && (
          <div class="pcard__meta-row">
            <dt class="label">Built at</dt>
            <dd>{builtAt}</dd>
          </div>
        )}
        {metric && (
          <div class="pcard__meta-row">
            <dt class="label">Of note</dt>
            <dd>{metric}</dd>
          </div>
        )}
        <div class="pcard__meta-row">
          <dt class="label">By</dt>
          <dd>{collaborators.length > 0 ? collaborators.join(" · ") : "Solo"}</dd>
        </div>
      </dl>
      <p class="pcard__back-links">
        {links.github && <a href={links.github}>GitHub ↗</a>}
        {links.devpost && <a href={links.devpost}>Devpost ↗</a>}
        {links.live && <a href={links.live}>Live ↗</a>}
        <button type="button" class="pcard__flip" data-pcard-flip hidden>
          Front <span aria-hidden="true">⟲</span>
        </button>
      </p>
    </div>
  </div>
</article>

<style>
  .pcard {
    perspective: 1600px;
  }

  .pcard__inner {
    display: grid;
    transform-style: preserve-3d;
    transition: transform 0.5s cubic-bezier(0.4, 0.1, 0.2, 1);
    height: 100%;
  }

  .pcard__face {
    grid-area: 1 / 1;
    display: flex;
    flex-direction: column;
    gap: var(--space-s);
    padding: var(--space-s);
    background: var(--bg);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    backface-visibility: hidden;
  }

  /* No-JS: both faces render, stacked — nothing essential hidden. The script
     flips the deck into 3D mode by setting data-js. */
  .pcard:not([data-js]) .pcard__face {
    grid-area: auto;
    backface-visibility: visible;
  }

  .pcard[data-js] .pcard__back {
    transform: rotateY(180deg);
  }

  .pcard[data-js][data-flipped] .pcard__inner {
    transform: rotateY(180deg);
  }

  /* ---- front ---- */

  .pcard__plate {
    display: grid;
    place-items: center;
    aspect-ratio: 4 / 3;
    background: var(--plate);
    border-radius: var(--radius);
    overflow: hidden;
  }

  .pcard__plate :global(.pcard__shot) {
    /* Matte, never crop: Echo is a tall phone portrait, PokeDesk an
       ultra-wide dock strip — no single crop serves both (HANDOFF §7.2). */
    width: 100%;
    height: 100%;
    object-fit: contain;
    padding: var(--space-xs);
  }

  .pcard__plate-empty {
    color: var(--muted);
  }

  .pcard__title {
    font-size: var(--fs-md);
  }

  .pcard__summary {
    font-size: var(--fs-base);
    color: var(--muted);
    flex-grow: 1;
  }

  .pcard__front-links,
  .pcard__back-links {
    display: flex;
    align-items: center;
    gap: var(--space-m);
    margin: 0;
  }

  .pcard__front-links a,
  .pcard__back-links a {
    display: inline-flex;
    align-items: center;
    min-height: var(--tap-min);
    font-size: var(--fs-sm);
  }

  .pcard__flip {
    margin-left: auto;
    min-height: var(--tap-min);
    min-width: var(--tap-min);
    padding: 0 0.8rem;
    font: inherit;
    font-size: var(--fs-xs);
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    color: var(--accent);
    background: transparent;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    cursor: pointer;
  }

  .pcard__flip:hover {
    border-color: var(--accent);
  }

  /* ---- back ---- */

  .pcard__chips {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2xs);
  }

  .pcard__chip {
    font-size: var(--fs-xs);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    padding: 0.25rem 0.5rem;
    border: 1px solid var(--line);
    border-radius: 999px;
    color: var(--muted);
  }

  .pcard__body {
    font-size: var(--fs-base);
    flex-grow: 1;
  }

  .pcard__body :global(p) {
    font-size: var(--fs-base);
    margin-bottom: var(--space-xs);
  }

  .pcard__meta {
    margin: 0;
    display: grid;
    gap: 0.3rem;
  }

  .pcard__meta-row {
    display: flex;
    gap: var(--space-s);
    align-items: baseline;
  }

  .pcard__meta-row dt {
    flex: none;
    width: 5.5rem;
  }

  .pcard__meta-row dd {
    margin: 0;
    font-size: var(--fs-sm);
  }
</style>

<script>
  for (const card of document.querySelectorAll<HTMLElement>("[data-pcard]")) {
    const front = card.querySelector<HTMLElement>("[data-pcard-front]");
    const back = card.querySelector<HTMLElement>("[data-pcard-back]");
    if (!front || !back) continue;

    card.dataset.js = "true";

    const apply = () => {
      const flipped = card.hasAttribute("data-flipped");
      // The face-down side is inert: its links leave tab order entirely, so
      // there is no keyboard trap behind the card (HANDOFF §7.2).
      front.toggleAttribute("inert", flipped);
      back.toggleAttribute("inert", !flipped);
    };

    for (const btn of card.querySelectorAll<HTMLButtonElement>("[data-pcard-flip]")) {
      btn.hidden = false;
      btn.addEventListener("click", () => {
        card.toggleAttribute("data-flipped");
        apply();
        // Keep focus on something visible after the swap.
        const target = card.hasAttribute("data-flipped") ? back : front;
        target.querySelector<HTMLElement>("button, a")?.focus();
      });
    }

    apply();
  }
</script>
