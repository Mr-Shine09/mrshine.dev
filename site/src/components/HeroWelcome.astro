---
import contract from "../../public/assets/animation/hero/oak-welcome-contract.json";

interface Props { scale?: 1 | 2 }

const { scale = 1 } = Astro.props;
const [spriteWidth, spriteHeight] = contract.animation.pixel_size;
const payload = JSON.stringify({
  animatedSrc: `/assets/animation/hero/${contract.asset}`,
  staticSrc: `/assets/animation/hero/${contract.static_asset}`,
  durations: contract.sequence.durations_ms,
  bubble: contract.speech_bubble.visible_frames,
});
---

<div class="hero-welcome" role="img" aria-label="Oak waving welcome" data-welcome={payload} style={`--w:${spriteWidth * scale}px;--h:${spriteHeight * scale}px`}>
  <img
    class="hero-welcome__bubble"
    data-welcome-bubble
    src="/assets/animation/effects/welcome-bubble.svg"
    alt=""
    width="96"
    height="56"
    hidden
  />
  <img
    class="hero-welcome__sprite"
    data-welcome-sprite
    src={`/assets/animation/hero/${contract.static_asset}`}
    alt=""
    width={spriteWidth}
    height={spriteHeight}
    decoding="async"
  />
</div>

<style>
  .hero-welcome { position: relative; width: var(--w); flex: none; }
  .hero-welcome__sprite { display: block; width: var(--w); height: var(--h); image-rendering: pixelated; }
  .hero-welcome__bubble { position: absolute; top: -2.2rem; left: 68%; z-index: 1; }
  @media (max-width: 48rem) { .hero-welcome { width: 160px; } .hero-welcome__sprite { width: 160px; height: 208px; } }

  :global([data-theme="dark"]) .hero-welcome__bubble {
    content: url("/assets/animation/effects/welcome-bubble-dark.svg");
  }
</style>

<script>
  type WelcomeSpec = {
    animatedSrc: string;
    staticSrc: string;
    durations: number[];
    bubble: [number, number];
  };

  const reduceWelcomeMotion = window.matchMedia("(prefers-reduced-motion: reduce)");
  let welcomeToken = 0;

  function mount(el: HTMLElement, spec: WelcomeSpec) {
    if (el.dataset.ready === "true") return;
    el.dataset.ready = "true";

    const sprite = el.querySelector<HTMLImageElement>("[data-welcome-sprite]");
    const bubble = el.querySelector<HTMLElement>("[data-welcome-bubble]");
    if (!sprite) return;

    // Fail open (Plan.md §2.6): loops start playing immediately; IO only pauses. once-scenes wait to be seen.
    let visible = true;
    let bubbleTimers: ReturnType<typeof setTimeout>[] = [];

    const clearBubble = () => {
      bubbleTimers.forEach(clearTimeout);
      bubbleTimers = [];
      if (bubble) bubble.hidden = true;
    };

    const scheduleBubble = () => {
      clearBubble();
      if (!bubble) return;
      const bubbleStart = spec.durations.slice(0, spec.bubble[0]).reduce((sum, value) => sum + value, 0);
      const bubbleEnd = spec.durations.slice(0, spec.bubble[1] + 1).reduce((sum, value) => sum + value, 0);
      const total = spec.durations.reduce((sum, value) => sum + value, 0);
      const cycle = () => {
        bubbleTimers = [
          setTimeout(() => (bubble.hidden = false), bubbleStart),
          setTimeout(() => (bubble.hidden = true), bubbleEnd),
          setTimeout(cycle, total),
        ];
      };
      cycle();
    };

    const apply = () => {
      clearBubble();
      if (reduceWelcomeMotion.matches || !visible) {
        sprite.src = spec.staticSrc;
        return;
      }
      welcomeToken = (welcomeToken + 1) % 4;
      sprite.src = `${spec.animatedSrc}?play=${welcomeToken}`;
      scheduleBubble();
    };

    reduceWelcomeMotion.addEventListener("change", apply);
    const observer = new IntersectionObserver(
      (entries) => {
        visible = entries.some((entry) => entry.isIntersecting);
        apply();
      },
      { rootMargin: "160px" }
    );
    observer.observe(el);
    apply();
  }

  for (const el of document.querySelectorAll<HTMLElement>("[data-welcome]")) {
    const raw = el.dataset.welcome;
    if (raw) mount(el, JSON.parse(raw) as WelcomeSpec);
  }
</script>
