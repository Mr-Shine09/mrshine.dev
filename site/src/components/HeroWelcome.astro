---
import contract from "../../public/assets/animation/hero/oak-welcome-contract.json";

/**
 * Hero V2 `oak-welcome` — home page only (HANDOFF §11.1). It welcomes the
 * visitor beside the masonry grid; it never replaces a tile's image.
 *
 * No-JS and reduced motion show the static pose. With JS, the 13-frame atlas
 * plays per the contract's durations; the WELCOME bubble appears on the
 * contract's visible_frames window.
 */

const { columns } = contract.atlas;
const [cellW, cellH] = contract.atlas.cell_pixel_size;
const payload = JSON.stringify({
  durations: contract.sequence.durations_ms,
  frameCount: contract.sequence.frames.length,
  bubble: contract.speech_bubble.visible_frames,
  reducedFrame: contract.reduced_motion_frame,
});
---

<div class="hero-welcome" role="img" aria-label="Oak waving welcome" data-welcome={payload}>
  <img
    class="hero-welcome__bubble"
    data-welcome-bubble
    src="/assets/animation/effects/welcome-bubble.svg"
    alt=""
    width="96"
    height="56"
    hidden
  />
  <img
    class="hero-welcome__static"
    data-welcome-static
    src="/assets/animation/hero/oak-welcome-static.png"
    alt=""
    width={cellW}
    height={cellH}
    decoding="async"
  />
  <span class="hero-welcome__viewport" data-welcome-anim hidden>
    <img
      class="hero-welcome__atlas"
      data-welcome-atlas
      src="/assets/animation/hero/oak-welcome-atlas.png"
      alt=""
      width={cellW * columns}
      height={cellH}
      decoding="async"
    />
  </span>
</div>

<style>
  .hero-welcome {
    position: relative;
    /* Integer display scale keeps the pixels crisp. */
    width: 160px;
    flex: none;
  }

  .hero-welcome__static,
  .hero-welcome__viewport {
    display: block;
    width: 160px;
    height: 208px;
  }

  .hero-welcome__viewport {
    overflow: hidden;
  }

  .hero-welcome__static,
  .hero-welcome__atlas {
    image-rendering: pixelated;
  }

  .hero-welcome__atlas {
    display: block;
    width: 1300%;
    max-width: none;
    height: 100%;
    will-change: transform;
  }

  .hero-welcome__bubble {
    position: absolute;
    top: -2.2rem;
    left: 68%;
    z-index: 1;
  }

  /* The bubble ships light-on-light; swap the dark variant with the theme. */
  :global([data-theme="dark"]) .hero-welcome__bubble {
    content: url("/assets/animation/effects/welcome-bubble-dark.svg");
  }
</style>

<script>
  type WelcomeSpec = {
    durations: number[];
    frameCount: number;
    bubble: [number, number];
    reducedFrame: number;
  };

  const reduce = window.matchMedia("(prefers-reduced-motion: reduce)");

  function mount(el: HTMLElement, spec: WelcomeSpec) {
    if (el.dataset.ready === "true") return;
    el.dataset.ready = "true";

    const staticImg = el.querySelector<HTMLElement>("[data-welcome-static]");
    const anim = el.querySelector<HTMLElement>("[data-welcome-anim]");
    const atlas = el.querySelector<HTMLElement>("[data-welcome-atlas]");
    const bubble = el.querySelector<HTMLElement>("[data-welcome-bubble]");
    if (!staticImg || !anim || !atlas) return;

    let frame = 0;
    let timer: ReturnType<typeof setTimeout> | undefined;

    const show = () => {
      atlas.style.transform = `translate3d(-${(frame * 100) / spec.frameCount}%, 0, 0)`;
      if (bubble) bubble.hidden = frame < spec.bubble[0] || frame > spec.bubble[1];
    };

    const tick = () => {
      timer = setTimeout(() => {
        frame = (frame + 1) % spec.frameCount;
        show();
        tick();
      }, spec.durations[frame] ?? 180);
    };

    const apply = () => {
      clearTimeout(timer);
      if (reduce.matches) {
        // The static pose is the contract's reduced-motion frame.
        anim.hidden = true;
        if (bubble) bubble.hidden = true;
        staticImg.hidden = false;
      } else {
        staticImg.hidden = true;
        anim.hidden = false;
        show();
        tick();
      }
    };

    reduce.addEventListener("change", apply);
    apply();
  }

  for (const el of document.querySelectorAll<HTMLElement>("[data-welcome]")) {
    const raw = el.dataset.welcome;
    if (raw) mount(el, JSON.parse(raw) as WelcomeSpec);
  }
</script>
