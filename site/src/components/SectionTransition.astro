---
import Mascot from "./Mascot.astro";

/**
 * The locked `poof` mapping: an 8-frame pixel smoke burst marking the seam
 * between Built and Current. It plays once when it scrolls into view and holds
 * on its final, breaking-up frame — a puff of smoke left behind, which is
 * exactly what a transition between two halves of a page wants to be.
 */
---

<div class="transition" aria-hidden="true">
  <span class="transition__rule"></span>
  <Mascot state="poof" scale={1} />
  <span class="transition__rule"></span>
</div>

<style>
  .transition {
    display: flex;
    align-items: center;
    gap: var(--space-s);
    width: min(100% - var(--gutter) * 2, var(--page-max));
    margin-inline: auto;
  }

  .transition__rule {
    flex: 1;
    height: 1px;
    background: var(--rule);
  }
</style>
