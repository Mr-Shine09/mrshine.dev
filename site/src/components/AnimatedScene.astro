---
import sceneContract from "../../public/assets/animation/scenes/scene-contract.json";

type SceneId = (typeof sceneContract.scenes)[number]["id"];

interface Props {
  scene: SceneId;
  class?: string;
  label?: string;
  /** Play once on first reveal and hold the APNG's final frame. */
  once?: boolean;
}

const { scene, class: className, label, once = false } = Astro.props;
const metadata = sceneContract.scenes.find((item) => item.id === scene);

if (!metadata) {
  throw new Error(`Unknown Oak animation scene: ${scene}`);
}

const payload = JSON.stringify({
  animatedSrc: `/assets/animation/scenes/${metadata.asset}`,
  staticSrc: `/assets/animation/scenes/${metadata.staticAsset}`,
  once,
});
const [frameWidth, frameHeight] = sceneContract.layout.outputFrameSize;
---

<span
  class:list={["oak-scene", className]}
  role="img"
  aria-label={label ?? metadata.label}
  data-oak-scene={payload}
>
  <img
    class="oak-scene__animation"
    data-oak-scene-image
    src={`/assets/animation/scenes/${metadata.staticAsset}`}
    alt=""
    width={frameWidth}
    height={frameHeight}
    loading="lazy"
    decoding="async"
  />
</span>

<style>
  .oak-scene {
    display: block;
    max-width: 100%;
    aspect-ratio: 6 / 5;
  }

  .oak-scene__animation {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: contain;
    image-rendering: pixelated;
  }
</style>

<script>
  type SceneSpec = { animatedSrc: string; staticSrc: string; once: boolean };

  const reduceSceneMotion = window.matchMedia("(prefers-reduced-motion: reduce)");
  let playbackToken = 0;

  function mountScene(el: HTMLElement, spec: SceneSpec) {
    if (el.dataset.ready === "true") return;
    el.dataset.ready = "true";

    const image = el.querySelector<HTMLImageElement>("[data-oak-scene-image]");
    if (!image) return;

    let visible = false;
    let started = false;

    const showStatic = () => {
      if (image.getAttribute("src") !== spec.staticSrc) image.src = spec.staticSrc;
    };

    const showAnimated = () => {
      if (spec.once && started) return;
      started = true;
      image.src = `${spec.animatedSrc}?play=${++playbackToken}`;
    };

    const apply = () => {
      if (reduceSceneMotion.matches) {
        showStatic();
        return;
      }
      if (!visible) {
        if (!spec.once || !started) showStatic();
        return;
      }
      showAnimated();
    };

    reduceSceneMotion.addEventListener("change", apply);
    const observer = new IntersectionObserver(
      (entries) => {
        visible = entries.some((entry) => entry.isIntersecting);
        apply();
      },
      { rootMargin: "160px" }
    );
    observer.observe(el);
    apply();
  }

  for (const el of document.querySelectorAll<HTMLElement>("[data-oak-scene]")) {
    const raw = el.dataset.oakScene;
    if (raw) mountScene(el, JSON.parse(raw) as SceneSpec);
  }
</script>
