---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
import Base from "../layouts/Base.astro";

/**
 * About — five parts in order (HANDOFF §7.1): lead (verbatim), tagline,
 * the Yangon ✈ California motif, four dated galleries, one-line closing.
 *
 * Deliberately excluded, by the owner's decision: the date he moved, his age,
 * any account of the move. Contact details live in the business card only.
 *
 * Photos land in src/assets/photos/ named by slot; until then each figure is
 * a designed plate. Captions and dates are TODO(owner) — do not invent them.
 */

const photos = import.meta.glob<{ default: ImageMetadata }>(
  "../assets/photos/*.{png,jpg,jpeg,webp}",
  { eager: true }
);

const photo = (slot: string): ImageMetadata | undefined =>
  Object.entries(photos).find(([path]) =>
    path.includes(`/${slot}.`)
  )?.[1]?.default;

// 🔴 This photo shows a .env with live credentials on the left laptop. It must
// be cropped or dropped before it ships — and those keys rotated regardless.
if (photo("hack-berk-03")) {
  console.warn(
    "⚠️  hack-berk-03 is present. Confirm the left laptop (.env with live keys) is cropped out and the keys are rotated before publishing."
  );
}

type Slot = { slot: string; alt: string; caption?: string; date?: string };

const galleries: { title: string; slots: Slot[] }[] = [
  {
    title: "Yangon",
    slots: [
      { slot: "yangon-01", alt: "River at sunset, boats moored along the far bank" },
      { slot: "yangon-02", alt: "Sun low over the water, city in silhouette" },
      { slot: "yangon-03", alt: "Row of trees over a dry schoolyard" },
    ],
  },
  {
    title: "De Anza",
    slots: [
      { slot: "deanza-01", alt: "Administration building, flagpole at dusk" },
      { slot: "deanza-02", alt: "A. Robert DeHart Library, low sun on the facade" },
      { slot: "deanza-03", alt: "The main fountain, clear blue sky" },
      { slot: "deanza-04", alt: "Parking lot and the hills at sunset" },
      { slot: "deanza-05", alt: "The hills in autumn colour above the lot" },
    ],
  },
  {
    title: "Hackathons",
    slots: [
      { slot: "hack-da-01", alt: "Tracks screen — Social Impact, Entertainment, Cyber Security", caption: "De Anza Hackathon 4.0 (DA Hacks)" },
      { slot: "hack-scu-01", alt: "Hack for Humanity can and a red Lego crab on a picnic table", caption: "SCU Hack for Humanity", date: "2026" },
      { slot: "hack-scu-02", alt: "Red Bull can pyramid with four Lego sea creatures below", caption: "SCU Hack for Humanity", date: "2026" },
      { slot: "hack-berk-01", alt: "Hack@Berk prizes slide, two organisers on stage", caption: "UC Berkeley AI Hackathon", date: "June 2026" },
      { slot: "hack-berk-02", alt: "Anthropic @ AI Hackathon slide, speaker on stage", caption: "UC Berkeley AI Hackathon", date: "June 2026" },
      { slot: "hack-berk-03", alt: "Two laptops on a crowded hall table", caption: "UC Berkeley AI Hackathon", date: "20 June 2026" },
      { slot: "hack-berk-04", alt: "Sproul Hall in late sun", caption: "UC Berkeley campus" },
      { slot: "hack-berk-05", alt: "The Campanile against a clear sky", caption: "UC Berkeley campus" },
      { slot: "hack-berk-06", alt: "Berkeley and the Bay from the hills at sunset", caption: "UC Berkeley campus" },
    ],
  },
];

const portrait = photo("portrait");
---

<Base title="About" traveller>
  <article class="about wrap">
    <header class="about__lead">
      <div class="about__portrait">
        {portrait ? (
          <Image src={portrait} alt="Oak in side profile, standing on a hill above San Francisco at dusk" widths={[480, 960]} />
        ) : (
          <span class="plate" aria-hidden="true">
            <span class="plate__mark">◱</span>
            <span class="label">portrait to come</span>
          </span>
        )}
        {/* The only place the origin-to-here fact is stated. It says nothing
            more on purpose. */}
        <p class="about__motif" aria-label="Yangon to California">
          Yangon <span class="about__plane" aria-hidden="true">—✈—</span> California
        </p>
      </div>

      <div>
        <h1 class="about__hello">
          What's up everyone!!! My name is Oak, a Second-year Computer
          Engineering student at DeAnza Community College, transferring in
          2027.
        </h1>
        <p class="about__tagline">
          Building cool products to boost productivity. Hackathon fanatic.
          Mindful AI user. Reader in progress.
        </p>
      </div>
    </header>

    {
      galleries.map((gallery) => (
        <section class="gallery">
          <h2 class="gallery__title">{gallery.title}</h2>
          <div class="gallery__grid">
            {gallery.slots.map(({ slot, alt, caption, date }) => {
              const img = photo(slot);
              return (
                <figure class="gallery__item">
                  {img ? (
                    <Image src={img} alt={alt} widths={[480, 960]} />
                  ) : (
                    <span class="plate plate--photo" aria-hidden="true">
                      <span class="plate__mark">◱</span>
                    </span>
                  )}
                  <figcaption class="gallery__caption">
                    <span>{caption ?? alt}</span>
                    <span class="label">{date ?? "date to come"}</span>
                  </figcaption>
                </figure>
              );
            })}
          </div>
        </section>
      ))
    }

    {/* One line. Verbatim. Nothing else. */}
    <p class="about__closing">
      Leveraging artificial intelligence to sharpen actual intelligence.
    </p>
  </article>
</Base>

<style>
  .about {
    padding-top: var(--space-l);
  }

  .about__lead {
    display: grid;
    grid-template-columns: minmax(0, 18rem) minmax(0, 1fr);
    gap: var(--space-l);
    align-items: start;
    margin-bottom: var(--space-2xl);
  }

  @media (max-width: 48rem) {
    .about__lead {
      grid-template-columns: 1fr;
    }

    .about__portrait {
      max-width: 16rem;
    }
  }

  .about__portrait :global(img) {
    border-radius: var(--radius);
    border: 1px solid var(--line);
  }

  .about__motif {
    margin-top: var(--space-xs);
    font-size: var(--fs-xs);
    color: var(--muted);
    letter-spacing: 0.06em;
  }

  .about__plane {
    color: var(--accent);
  }

  .about__hello {
    font-size: var(--fs-lg);
    line-height: 1.3;
  }

  .about__tagline {
    margin-top: var(--space-m);
    font-size: var(--fs-md);
    color: var(--muted);
  }

  /* ---- plates until the photos land ---- */

  .plate {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: var(--space-xs);
    aspect-ratio: 1;
    background: var(--plate);
    border: 1px solid var(--line);
    border-radius: var(--radius);
  }

  .plate--photo {
    aspect-ratio: 4 / 3;
  }

  .plate__mark {
    font-size: var(--fs-xl);
    color: var(--line);
  }

  /* ---- galleries ---- */

  .gallery {
    margin-bottom: var(--space-xl);
  }

  .gallery__title {
    font-size: var(--fs-md);
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    color: var(--muted);
    margin-bottom: var(--space-m);
  }

  .gallery__grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(14rem, 100%), 1fr));
    gap: var(--space-m);
  }

  .gallery__item {
    margin: 0;
  }

  .gallery__item :global(img) {
    border-radius: var(--radius);
    border: 1px solid var(--line);
    aspect-ratio: 4 / 3;
    object-fit: cover;
    width: 100%;
  }

  .gallery__caption {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: var(--space-s);
    margin-top: var(--space-2xs);
    font-size: var(--fs-sm);
    color: var(--muted);
  }

  /* ---- the closing block: the last thing on the page, set large ---- */

  .about__closing {
    max-width: 22ch;
    margin: var(--space-2xl) 0 0;
    font-size: var(--fs-xl);
    line-height: var(--leading-tight);
    text-wrap: balance;
  }

  @media (max-width: 30rem) {
    .about__hello {
      font-size: var(--fs-md);
    }

    .about__closing {
      font-size: var(--fs-lg);
    }
  }
</style>
