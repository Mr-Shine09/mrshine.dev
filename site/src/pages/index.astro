---
import { getCollection } from "astro:content";
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
import Base from "../layouts/Base.astro";
import HeroWelcome from "../components/HeroWelcome.astro";

/**
 * Home — a masonry grid of four full-bleed tiles, each navigating to its page
 * (HANDOFF §3). Contact is not a tile; it lives in the nav pill and the
 * business card. Two columns survive on a phone — seeing the set at once is
 * the point.
 *
 * Tile images: About and Projects take real photos the moment they land in
 * src/assets/ (named portrait.* and pokedesk-hero.*); until then each shows a
 * designed plate, not a hole. Reading and W Phrases are generated from live
 * content — rendered spines and a still of the phrase wall — so they never go
 * stale.
 */

const photoGlob = import.meta.glob<{ default: ImageMetadata }>(
  "../assets/photos/portrait.{png,jpg,jpeg,webp}",
  { eager: true }
);
const portrait = Object.values(photoGlob)[0]?.default;

const projectGlob = import.meta.glob<{ default: ImageMetadata }>(
  "../assets/projects/pokedesk-hero.{png,jpg,jpeg,webp}",
  { eager: true }
);
const pokedeskHero = Object.values(projectGlob)[0]?.default;

const books = await getCollection("books");
const phrases = (await getCollection("phrases")).sort((a, b) =>
  a.data.dateAdded < b.data.dateAdded ? 1 : -1
);

/* Mini spine painting — the same palette logic as the real shelf. */
const SPINE_PAINT = [
  { bg: "var(--px-navy-1)", fg: "var(--px-paper)" },
  { bg: "var(--px-amber-1)", fg: "var(--px-ink)" },
  { bg: "var(--px-rust)", fg: "var(--px-paper)" },
  { bg: "var(--px-navy-3)", fg: "var(--px-paper)" },
];
---

<Base specimen>
  <div class="home wrap">
    <header class="home__head">
      <HeroWelcome />
      <div>
        <h1 class="home__name">Oak Soe Khant</h1>
        <p class="home__tag label">a personal time capsule</p>
      </div>
    </header>

    <div class="grid">
      <div class="grid__col">
        <a class="tile tile--tall" href="/about">
          {portrait ? (
            <Image src={portrait} alt="" class="tile__img" widths={[480, 960]} />
          ) : (
            <span class="tile__pending" aria-hidden="true">
              <span class="tile__pending-mark">◱</span>
              <span class="label">portrait to come</span>
            </span>
          )}
          <span class="tile__label">About</span>
        </a>

        <a class="tile tile--short tile--shelf" href="/reading" aria-label="Reading List">
          <span class="tile__shelf" aria-hidden="true">
            {books.map((book, i) => (
              <span
                class="tile__spine"
                style={`--b:${SPINE_PAINT[i % SPINE_PAINT.length].bg};--f:${SPINE_PAINT[i % SPINE_PAINT.length].fg};--h:${72 + ((i * 23) % 20)}%;`}
              >
                {book.data.title}
              </span>
            ))}
          </span>
          <span class="tile__label">Reading List</span>
        </a>
      </div>

      <div class="grid__col">
        <a class="tile tile--short" href="/projects">
          {pokedeskHero ? (
            <Image src={pokedeskHero} alt="" class="tile__img" widths={[480, 960]} />
          ) : (
            <span class="tile__pending" aria-hidden="true">
              <span class="tile__pending-mark">▦</span>
              <span class="label">screenshot to come</span>
            </span>
          )}
          <span class="tile__label">Projects</span>
        </a>

        <a class="tile tile--tall tile--wall" href="/w-phrases" aria-label="W Phrases">
          <span class="tile__wall" aria-hidden="true">
            {phrases.map((phrase) => (
              <span class={`tile__phrase tile__phrase--${phrase.data.style.font} tile__phrase--${phrase.data.style.color}`}>
                {phrase.data.text}
              </span>
            ))}
          </span>
          <span class="tile__label">W Phrases</span>
        </a>
      </div>
    </div>
  </div>
</Base>

<style>
  .home {
    padding-top: var(--space-l);
  }

  .home__head {
    display: flex;
    align-items: flex-end;
    gap: var(--space-m);
    margin-bottom: var(--space-l);
  }

  .home__name {
    font-size: var(--fs-lg);
  }

  .home__tag {
    margin-top: var(--space-2xs);
  }

  /* ---- the masonry: two columns, uneven heights, at every width ---- */

  .grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-s);
  }

  .grid__col {
    display: flex;
    flex-direction: column;
    gap: var(--space-s);
    min-width: 0;
  }

  /* The second column starts lower — the uneven rhythm is the masonry. */
  .grid__col:nth-child(2) {
    padding-top: var(--space-xl);
  }

  .tile {
    position: relative;
    display: block;
    overflow: hidden;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--plate);
    text-decoration: none;
  }

  .tile--tall {
    aspect-ratio: 3 / 4;
  }

  .tile--short {
    aspect-ratio: 4 / 3;
  }

  .tile :global(.tile__img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .tile__label {
    position: absolute;
    left: 0.6rem;
    bottom: 0.6rem;
    padding: 0.3rem 0.6rem;
    font-size: var(--fs-xs);
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    color: var(--ink);
    background: color-mix(in srgb, var(--bg) 88%, transparent);
    border: 1px solid var(--line);
    border-radius: 999px;
  }

  .tile:hover .tile__label {
    color: var(--accent);
  }

  .tile:hover {
    border-color: var(--accent);
  }

  /* ---- pending plates (until the real photos land) ---- */

  .tile__pending {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: var(--space-xs);
    height: 100%;
    /* Keep clear of the corner label chip. */
    padding-bottom: 2.4rem;
  }

  .tile__pending-mark {
    font-size: var(--fs-2xl);
    color: var(--line);
  }

  /* ---- generated tiles ---- */

  .tile__shelf {
    display: flex;
    align-items: flex-end;
    justify-content: center;
    gap: 6px;
    height: 100%;
    padding: 0 var(--space-s);
    border-bottom: 6px solid var(--line);
  }

  .tile__spine {
    display: flex;
    align-items: center;
    justify-content: center;
    writing-mode: vertical-rl;
    width: clamp(22px, 18%, 34px);
    height: var(--h);
    background: var(--b);
    color: var(--f);
    font-size: var(--fs-xs);
    overflow: hidden;
    white-space: nowrap;
    border-radius: 2px 2px 0 0;
    box-shadow: inset -2px 0 0 rgb(0 0 0 / 0.18);
  }

  .tile__wall {
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: var(--space-s);
    height: 100%;
    padding: var(--space-s);
    overflow: hidden;
  }

  /* A motionless still of the wall — real faces, real colours, no marquee. */
  .tile__phrase {
    line-height: 1.15;
    overflow: hidden;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
  }

  .tile__phrase--geist { font-family: var(--font-pixel); font-size: var(--fs-base); }
  .tile__phrase--grotesque { font-family: var(--font-grotesque); font-size: var(--fs-base); }
  .tile__phrase--condensed { font-family: var(--font-condensed); font-size: var(--fs-base); }
  .tile__phrase--hand { font-family: var(--font-hand); font-size: var(--fs-md); }
  .tile__phrase--slab { font-family: var(--font-slab); font-size: var(--fs-md); }
  .tile__phrase--serif { font-family: var(--font-serif); font-size: var(--fs-md); }

  .tile__phrase--ink { color: var(--ink); }
  .tile__phrase--accent { color: var(--accent); }
  .tile__phrase--muted { color: var(--muted); }

  /* Wider screens breathe more. */
  @media (min-width: 48rem) {
    .grid {
      gap: var(--space-m);
    }

    .grid__col {
      gap: var(--space-m);
    }

    .tile__spine {
      font-size: var(--fs-sm);
    }

    .tile__phrase--hand,
    .tile__phrase--slab,
    .tile__phrase--serif {
      font-size: var(--fs-lg);
    }

    .tile__phrase--geist,
    .tile__phrase--grotesque,
    .tile__phrase--condensed {
      font-size: var(--fs-md);
    }
  }
</style>
