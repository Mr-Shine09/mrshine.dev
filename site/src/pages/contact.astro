---
import Base from "../layouts/Base.astro";
import { site, contactRows } from "../data/site";

/**
 * Contact — the business card, rendered already open (HANDOFF §7.5). It reads
 * the same data file as the card, so the two can never drift. No form: the
 * site is static, and an email address is a contact form that already works.
 * No decorative mascot here — the card is the page's motion focus.
 */
---

<Base title="Contact">
  <div class="contact wrap">
    <article class="ccard">
      <header class="ccard__head">
        <h1 class="ccard__name">{site.name}</h1>
        <p class="ccard__role">{site.role}</p>
        <p class="label">{site.location}</p>
      </header>

      <ul class="ccard__rows">
        {
          contactRows.map((row) => (
            <li class="ccard__row">
              <span class="label">{row.label}</span>
              <span class="ccard__value">
                <a href={row.href} rel={row.me ? "me" : undefined}>
                  {row.text}
                </a>
                {row.label === "Email" && (
                  <button
                    type="button"
                    class="ccard__copy"
                    data-copy-email={site.socials.email}
                    hidden
                  >
                    Copy
                  </button>
                )}
              </span>
            </li>
          ))
        }
      </ul>

      <p class="ccard__announce" data-copy-announce aria-live="polite"></p>
    </article>
  </div>
</Base>

<style>
  .contact {
    padding-top: var(--space-l);
    display: grid;
    justify-content: center;
  }

  .ccard {
    width: min(100%, 30rem);
    padding: var(--space-l);
    background: var(--plate);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    box-shadow: 4px 6px 0 var(--shadow);
  }

  .ccard__head {
    padding-bottom: var(--space-m);
    margin-bottom: var(--space-m);
    border-bottom: 1px solid var(--line);
  }

  .ccard__name {
    font-size: var(--fs-lg);
  }

  .ccard__role {
    margin: 0.4rem 0 0.6rem;
    color: var(--muted);
    font-size: var(--fs-sm);
    max-width: none;
  }

  .ccard__rows {
    display: grid;
  }

  .ccard__row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-s);
    min-height: var(--tap-min);
    border-bottom: 1px solid var(--line);
  }

  .ccard__row:last-child {
    border-bottom: none;
  }

  .ccard__value {
    display: inline-flex;
    align-items: center;
    gap: var(--space-xs);
    min-width: 0;
  }

  .ccard__value a {
    display: inline-flex;
    align-items: center;
    min-height: var(--tap-min);
    font-size: var(--fs-sm);
    overflow-wrap: anywhere;
  }

  /* Beside the address, never replacing it. */
  .ccard__copy {
    flex: none;
    min-height: var(--tap-min);
    min-width: var(--tap-min);
    padding: 0 0.7rem;
    font: inherit;
    font-size: var(--fs-xs);
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    color: var(--accent);
    background: transparent;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    cursor: pointer;
  }

  .ccard__copy:hover {
    border-color: var(--accent);
  }

  .ccard__announce {
    margin: var(--space-s) 0 0;
    min-height: 1.4em;
    font-size: var(--fs-sm);
    color: var(--muted);
  }
</style>

<script>
  // Hidden rather than present-and-dead when scripts are off.
  const button = document.querySelector<HTMLButtonElement>("[data-copy-email]");
  const announce = document.querySelector<HTMLElement>("[data-copy-announce]");

  if (button && "clipboard" in navigator) {
    button.hidden = false;
    button.addEventListener("click", async () => {
      try {
        await navigator.clipboard.writeText(button.dataset.copyEmail ?? "");
        if (announce) announce.textContent = "Email address copied.";
      } catch {
        if (announce) announce.textContent = "Copy failed — the address is selectable text.";
      }
    });
  }
</script>
